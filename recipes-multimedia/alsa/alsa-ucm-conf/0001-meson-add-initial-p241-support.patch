From fa137d42090557417387c609dee5aa236d5500da Mon Sep 17 00:00:00 2001
From: Jerome Brunet <jbrunet@baylibre.com>
Date: Mon, 27 Sep 2021 22:23:40 +0200
Subject: [PATCH 1/2] meson: add initial p241 support

Add support for the p241 board, the amlogic s905x reference design

Signed-off-by: Jerome Brunet <jbrunet@baylibre.com>
---
 ucm2/Meson/p241/p241-HiFi.conf          | 38 +++++++++++++++++++++++++
 ucm2/Meson/p241/p241.conf               |  8 ++++++
 ucm2/conf.d/gx-sound-card/GXL-P241.conf |  1 +
 3 files changed, 47 insertions(+)
 create mode 100644 ucm2/Meson/p241/p241-HiFi.conf
 create mode 100644 ucm2/Meson/p241/p241.conf
 create mode 120000 ucm2/conf.d/gx-sound-card/GXL-P241.conf

diff --git a/ucm2/Meson/p241/p241-HiFi.conf b/ucm2/Meson/p241/p241-HiFi.conf
new file mode 100644
index 000000000000..ff0faadd747f
--- /dev/null
+++ b/ucm2/Meson/p241/p241-HiFi.conf
@@ -0,0 +1,38 @@
+SectionVerb {
+	Value {
+		PlaybackPriority 100
+		PlaybackPCM "hw:${CardId},0"
+	}
+}
+
+SectionDevice."Line" {
+	Comment "Analog Lineout"
+
+	EnableSequence [
+		cset "name='AIU ACODEC SRC' I2S"
+		cset "name='AIU ACODEC I2S Lane Select' 0"
+		cset "name='AIU ACODEC OUT EN Switch' 1"
+		cset "name='ACODEC Playback Switch' 1"
+	]
+	DisableSequence [
+		cset "name='ACODEC Playback Switch' 0"
+		cset "name='AIU ACODEC OUT EN Switch' 0"
+		cset "name='AIU ACODEC SRC' DISABLED"
+	]
+	Value {
+		PlaybackChannels 2
+		PlaybackVolume "ACODEC Playback Volume"
+		PlaybackMixerElem "ACODEC"
+	}
+}
+
+SectionDevice."HDMI" {
+	Comment "HDMI"
+
+	EnableSequence [
+		cset "name='AIU HDMI CTRL SRC' I2S"
+	]
+	DisableSequence [
+		cset "name='AIU HDMI CTRL SRC' DISABLED"
+	]
+}
diff --git a/ucm2/Meson/p241/p241.conf b/ucm2/Meson/p241/p241.conf
new file mode 100644
index 000000000000..122c6cb74abd
--- /dev/null
+++ b/ucm2/Meson/p241/p241.conf
@@ -0,0 +1,8 @@
+# Use case for the p241 Amlogic s805x reference design
+
+Syntax 3
+
+SectionUseCase."HiFi" {
+	File "/Meson/p241/p241-HiFi.conf"
+	Comment "Play HiFi quality Music"
+}
diff --git a/ucm2/conf.d/gx-sound-card/GXL-P241.conf b/ucm2/conf.d/gx-sound-card/GXL-P241.conf
new file mode 120000
index 000000000000..280ea38b04d7
--- /dev/null
+++ b/ucm2/conf.d/gx-sound-card/GXL-P241.conf
@@ -0,0 +1 @@
+../../Meson/p241/p241.conf
\ No newline at end of file
-- 
2.35.1

