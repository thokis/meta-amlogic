# short-description: Create SD card image for Amlogic devices
# long-description: Creates a partitioned SD card image for Amlogic devices.
# Boot files are located in the first vfat partition.

part /boot --source bootimg-partition --fstype=vfat --label BOOT --active --align 2048 --size 128 --sourceparams="loader=u-boot" --use-uuid
part / --source rootfs --ondisk mmcblk --fstype=ext4 --label root --align 4 --size 256 --use-uuid

bootloader --source bootsd-aml --ptable msdos --append="console=ttyAML0,115200 rootwait"
