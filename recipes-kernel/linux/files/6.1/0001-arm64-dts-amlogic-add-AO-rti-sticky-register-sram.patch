From 48eead5a6ff523df3bc314fb81fac7616698d567 Mon Sep 17 00:00:00 2001
From: Jerome Brunet <jbrunet@baylibre.com>
Date: Tue, 6 Sep 2022 16:32:54 +0200
Subject: [PATCH] arm64: dts: amlogic: add AO rti sticky register sram

Add the general purpose scratch registers AO_RTI_STICKY as
an sram device.

Signed-off-by: Jerome Brunet <jbrunet@baylibre.com>
---
 arch/arm64/boot/dts/amlogic/meson-axg.dtsi        | 8 ++++++++
 arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi | 8 ++++++++
 arch/arm64/boot/dts/amlogic/meson-gx.dtsi         | 8 ++++++++
 3 files changed, 24 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/meson-axg.dtsi b/arch/arm64/boot/dts/amlogic/meson-axg.dtsi
index 6cc685f91fc9..e3ab3695d000 100644
--- a/arch/arm64/boot/dts/amlogic/meson-axg.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-axg.dtsi
@@ -1655,6 +1655,14 @@ mux {
 				};
 			};
 
+			rti_sticky_AO: sram@130 {
+				compatible = "mmio-sram";
+				reg = <0x0 0x130 0x0 0x10>;
+				ranges = <0 0x0 0x130 0x10>;
+				#address-cells = <1>;
+				#size-cells = <1>;
+			};
+
 			sec_AO: ao-secure@140 {
 				compatible = "amlogic,meson-gx-ao-secure", "syscon";
 				reg = <0x0 0x140 0x0 0x140>;
diff --git a/arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi b/arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi
index 131a8a5a9f5a..66d04ada1a1b 100644
--- a/arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi
@@ -2017,6 +2017,14 @@ cec_AO: cec@100 {
 				status = "disabled";
 			};
 
+			rti_sticky_AO: sram@130 {
+				compatible = "mmio-sram";
+				reg = <0x0 0x130 0x0 0x10>;
+				ranges = <0 0x0 0x130 0x10>;
+				#address-cells = <1>;
+				#size-cells = <1>;
+			};
+
 			sec_AO: ao-secure@140 {
 				compatible = "amlogic,meson-gx-ao-secure", "syscon";
 				reg = <0x0 0x140 0x0 0x140>;
diff --git a/arch/arm64/boot/dts/amlogic/meson-gx.dtsi b/arch/arm64/boot/dts/amlogic/meson-gx.dtsi
index 80d86780cb6b..e779e568a05f 100644
--- a/arch/arm64/boot/dts/amlogic/meson-gx.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-gx.dtsi
@@ -466,6 +466,14 @@ cec_AO: cec@100 {
 				status = "disabled";
 			};
 
+			rti_sticky_AO: sram@130 {
+				compatible = "mmio-sram";
+				reg = <0x0 0x00130 0x0 0x10>;
+				ranges = <0 0x0 0x130 0x10>;
+				#address-cells = <1>;
+				#size-cells = <1>;
+			};
+
 			sec_AO: ao-secure@140 {
 				compatible = "amlogic,meson-gx-ao-secure", "syscon";
 				reg = <0x0 0x140 0x0 0x140>;
-- 
2.30.2

